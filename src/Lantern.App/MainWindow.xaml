<Window x:Class="Lantern.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Lantern.App" Title="Lantern · Gần nhau hơn" Width="1280" Height="820" MinWidth="780" MinHeight="580" WindowStartupLocation="CenterScreen" Loaded="WindowLoaded" Closing="WindowClosing" SizeChanged="WindowSizeChanged" AllowDrop="True" Drop="FileDrop" PreviewDragOver="FileDragOver">
 <Window.Resources>
  <Style x:Key="ContactItem" TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="8,3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ContactBorder" Background="Transparent" CornerRadius="8" Padding="12"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ContactBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ContactBorder" Property="Background" Value="{DynamicResource SoftBrush}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ContactBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="ContactBorder" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Grid x:Name="Shell">
   <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition x:Name="ContactsColumn" Width="290"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailsColumn" Width="250"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
    <DockPanel Margin="12,16">
     <Border DockPanel.Dock="Top" Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentBrush}" Margin="0,0,0,26"><TextBlock Text="&#xE8F2;" Style="{StaticResource Icon}" Foreground="White" HorizontalAlignment="Center"/></Border>
     <StackPanel DockPanel.Dock="Bottom">
      <Button Style="{StaticResource RailButton}" Click="LockAppClick" ToolTip="Khóa ứng dụng (Ctrl+L)" AutomationProperties.Name="Khóa ứng dụng"><TextBlock Text="&#xE72E;" Style="{StaticResource Icon}"/></Button>
      <Button Style="{StaticResource RailButton}" Click="ThemeClick" ToolTip="Đổi giao diện sáng / tối" AutomationProperties.Name="Đổi giao diện"><TextBlock Text="&#xE708;" Style="{StaticResource Icon}"/></Button>
      <Button x:Name="UpdateButton" Style="{StaticResource RailButton}" Click="UpdatesClick" ToolTip="Cập nhật ứng dụng"><TextBlock Text="&#xE777;" Style="{StaticResource Icon}"/></Button><Button Style="{StaticResource RailButton}" Click="SettingsClick" ToolTip="Hồ sơ và cài đặt" AutomationProperties.Name="Hồ sơ và cài đặt"><TextBlock Text="&#xE713;" Style="{StaticResource Icon}"/></Button>
      <Button x:Name="SelfPresenceButton" Click="PresenceClick" Style="{StaticResource RailButton}" ToolTip="Trạng thái của bạn"><Ellipse x:Name="SelfPresenceDot" Width="10" Height="10" Fill="#20A464"/></Button><Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentSoftBrush}" Margin="0,12,0,0"><Grid><TextBlock x:Name="MyInitials" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/><Image x:Name="MyAvatar" Width="36" Height="36" Stretch="UniformToFill"><Image.Clip><EllipseGeometry Center="18,18" RadiusX="18" RadiusY="18"/></Image.Clip></Image></Grid></Border>
     </StackPanel>
     <StackPanel>
      <Button Style="{StaticResource RailButton}" Click="ChatsClick" ToolTip="Trò chuyện" Background="{DynamicResource AccentSoftBrush}" AutomationProperties.Name="Trò chuyện"><TextBlock Text="&#xE8F2;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentBrush}"/></Button>
      <Button Style="{StaticResource RailButton}" Click="FindPeopleClick" ToolTip="Tìm người theo tên qua các máy đã ghép đôi" AutomationProperties.Name="Tìm người theo tên"><TextBlock Text="&#xE721;" Style="{StaticResource Icon}"/></Button><Button Style="{StaticResource RailButton}" Click="DiscoverClick" ToolTip="Tìm máy trong LAN" AutomationProperties.Name="Tìm máy trong LAN"><TextBlock Text="&#xE968;" Style="{StaticResource Icon}"/></Button>
      <Button Style="{StaticResource RailButton}" Click="NewGroupClick" ToolTip="Tạo nhóm trò chuyện" AutomationProperties.Name="Tạo nhóm"><TextBlock Text="&#xE902;" Style="{StaticResource Icon}"/></Button>
     </StackPanel>
    </DockPanel>
   </Border>
   <Border Grid.Column="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Background="{DynamicResource SurfaceBrush}">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="20,24,20,14">
      <TextBlock Text="Lantern" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Kết nối gần. Chia sẻ nhanh." Style="{StaticResource Muted}" Margin="0,4,0,22"/>
      <Grid><TextBox x:Name="ContactSearch" TextChanged="ContactSearchChanged" ToolTip="Tìm người hoặc nhóm" AutomationProperties.Name="Tìm người hoặc nhóm"/><TextBlock Text="Tìm người hoặc nhóm…" Margin="13,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource MutedBrush}" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ContactSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
      <Grid Margin="0,20,0,0"><TextBlock Text="TRÒ CHUYỆN" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="OnlineCount" HorizontalAlignment="Right" Style="{StaticResource Muted}"/></Grid>
     </StackPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="16,12,16,18">
      <Button Click="AddPeerClick" HorizontalContentAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,8,0"/><TextBlock Text="Kết nối bằng IP" VerticalAlignment="Center"/></StackPanel></Button>
      <TextBlock Text="Trong cùng mạng, luôn gần nhau." Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" Margin="0,12,0,0"/>
     </StackPanel>
     <Grid>
      <ListBox x:Name="ContactsList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ContactItem}" SelectionChanged="ContactSelected" ContextMenuOpening="ContactsContextMenuOpening" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Danh sách trò chuyện">
       <ListBox.ContextMenu><ContextMenu/></ListBox.ContextMenu>
       <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource SoftBrush}" VerticalAlignment="Top"><Grid><TextBlock Text="{Binding Initials}" Visibility="{Binding InitialsVisibility}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding AvatarSource}" Width="38" Height="38" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,38,38" RadiusX="12" RadiusY="12"/></Image.Clip></Image></Grid></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><DockPanel Margin="0,5,0,0"><Ellipse Width="7" Height="7" Fill="{Binding PresenceColor}" Visibility="{Binding PresenceVisibility}" Margin="0,0,5,0" VerticalAlignment="Center" ToolTip="{Binding PresenceLabel}"/><TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/></DockPanel></StackPanel><Border Grid.Column="2" Visibility="{Binding UnreadVisibility}" Background="{DynamicResource AccentBrush}" CornerRadius="10" MinWidth="21" Height="21" Padding="5,0" Margin="5,0,0,0" VerticalAlignment="Top"><TextBlock Text="{Binding UnreadLabel}" Foreground="White" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border></Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <StackPanel x:Name="NoContacts" Margin="24,30" IsHitTestVisible="False"><TextBlock Text="Chưa có cuộc trò chuyện" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Mở Lantern trên máy khác trong LAN. Các máy sẽ xuất hiện tại đây." TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
     </Grid>
    </DockPanel>
   </Border>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="26,19">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ChatTitle" Text="Không gian của bạn" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ChatSubtitle" Text="Những cuộc trò chuyện ở ngay bên cạnh" Style="{StaticResource Muted}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="HeaderLockButton" Click="LockConversationClick" Style="{StaticResource RailButton}" Visibility="Collapsed" ToolTip="Khóa hội thoại ngay" AutomationProperties.Name="Khóa hội thoại ngay"><TextBlock Text="&#xE72E;" Style="{StaticResource Icon}"/></Button><Button Click="DetailsClick" Style="{StaticResource RailButton}" ToolTip="Thông tin cuộc trò chuyện" AutomationProperties.Name="Thông tin cuộc trò chuyện"><TextBlock Text="&#xE946;" Style="{StaticResource Icon}"/></Button></StackPanel></Grid>
    </Border>
    <StackPanel Grid.Row="1">
     <Border x:Name="PinnedMessageBar" Visibility="Collapsed" Margin="16,8,16,4" Padding="6" CornerRadius="8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Button x:Name="PinnedMessagePreview" Click="PinnedMessagePreviewClick" Background="Transparent" BorderThickness="0" Padding="8,4" HorizontalContentAlignment="Stretch" ToolTip="Đi tới tin nhắn đã ghim" AutomationProperties.Name="Đi tới tin nhắn đã ghim">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE718;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentBrush}"/><StackPanel Grid.Column="1"><TextBlock Text="Tin nhắn đã ghim" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="PinnedMessageSummary" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,3,0,0"/></StackPanel></Grid>
       </Button>
       <Button x:Name="PinnedMessagesDropdown" Grid.Column="1" Click="ShowPinnedMessagesClick" Margin="6,0" Padding="9,5" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Chọn tin nhắn đã ghim" AutomationProperties.Name="Chọn tin nhắn đã ghim"/>
       <Button x:Name="UnpinMessageButton" Grid.Column="2" Click="UnpinMessageClick" Content="×" Padding="8,4" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" ToolTip="Bỏ ghim tin nhắn này" AutomationProperties.Name="Bỏ ghim tin nhắn này"/>
      </Grid>
     </Border>
     <Border x:Name="PairBanner" Background="{DynamicResource AccentSoftBrush}" Padding="20,12" Visibility="Collapsed"><DockPanel><Button DockPanel.Dock="Right" Content="Xác minh" Click="PairClick" Style="{StaticResource AccentButton}"/><TextBlock Text="Xác minh máy này để bắt đầu trò chuyện." TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/></DockPanel></Border>
     <Border x:Name="SelectionBar" Background="{DynamicResource AccentSoftBrush}" Padding="16,8" Visibility="Collapsed"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="DeleteSelectedButton" Content="Xóa đã chọn" Click="DeleteSelectedClick" Margin="8,0"/><Button Content="Hủy chọn" Click="CancelSelectionClick"/></StackPanel><TextBlock x:Name="SelectionCount" Text="Chọn tin nhắn cần xóa" VerticalAlignment="Center"/></DockPanel></Border>
    </StackPanel>
    <Grid Grid.Row="2">
     <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="MessagesPanel" Margin="26,22"/></ScrollViewer>
     <StackPanel x:Name="WelcomePanel" MaxWidth="400" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="36">
      <Border Width="84" Height="84" Background="{DynamicResource AccentSoftBrush}" CornerRadius="26" HorizontalAlignment="Center" Margin="0,0,0,24"><TextBlock Text="&#xE8F2;" Style="{StaticResource Icon}" FontSize="34" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/></Border>
      <TextBlock x:Name="WelcomeTitle" Text="Một lời chào,&#x0a;ngay trong mạng của bạn." FontSize="30" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
      <TextBlock x:Name="WelcomeBody" Text="Chat, gửi ảnh và chia sẻ tệp trực tiếp.&#x0a;Mọi thứ ở lại trên máy của bạn." Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="23" Margin="0,16,0,24"/>
      <Button x:Name="WelcomeAction" Content="Tìm người trong LAN" Style="{StaticResource AccentButton}" Click="DiscoverClick" HorizontalAlignment="Center"/>
      <TextBlock Text="Không cần tài khoản · Không cần Internet" Style="{StaticResource Muted}" FontSize="11" TextAlignment="Center" Margin="0,24,0,0"/>
     </StackPanel>
    </Grid>
    <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,16,20,12">
     <StackPanel>
      <Border x:Name="ReplyBanner" Visibility="Collapsed" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,8"><DockPanel><Button DockPanel.Dock="Right" Content="×" Click="CancelReplyClick" ToolTip="Hủy trả lời" Padding="8,2"/><TextBlock x:Name="ReplyPreview" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/></DockPanel></Border>
      <DockPanel LastChildFill="False">
       <StackPanel Orientation="Horizontal">
        <Button x:Name="AttachButton" Click="AttachClick" Style="{StaticResource RailButton}" ToolTip="Gửi tệp (Ctrl+O)" AutomationProperties.Name="Gửi tệp"><TextBlock Text="&#xE723;" Style="{StaticResource Icon}"/></Button>
        <Button x:Name="EmojiButton" Click="EmojiClick" Style="{StaticResource RailButton}" ToolTip="Chọn emoji" AutomationProperties.Name="Chọn emoji"><TextBlock Text="&#xE899;" Style="{StaticResource Icon}"/></Button>
        <Button x:Name="StickerButton" Click="StickerClick" Style="{StaticResource RailButton}" ToolTip="Sticker và xưởng chế tác" AutomationProperties.Name="Chọn sticker"><TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}"/></Button>
        <Button x:Name="FormatButton" Click="FormatClick" Style="{StaticResource RailButton}" ToolTip="Soạn thảo chuyên sâu (Ctrl+Shift+X)" AutomationProperties.Name="Soạn thảo chuyên sâu" IsEnabled="{Binding IsEnabled, ElementName=Composer}"><TextBlock Text="A✎" FontSize="18"/></Button>
        <Button x:Name="PollButton" Click="CreatePollClick" Style="{StaticResource RailButton}" Visibility="Collapsed" ToolTip="Tạo bình chọn trong nhóm" AutomationProperties.Name="Tạo bình chọn"><Viewbox Width="18" Height="18"><Canvas Width="20" Height="20"><Rectangle Canvas.Left="1" Canvas.Top="10" Width="4" Height="9" Fill="{DynamicResource TextBrush}"/><Rectangle Canvas.Left="8" Canvas.Top="2" Width="4" Height="17" Fill="{DynamicResource TextBrush}"/><Rectangle Canvas.Left="15" Canvas.Top="6" Width="4" Height="13" Fill="{DynamicResource TextBrush}"/></Canvas></Viewbox></Button>
       </StackPanel>
       <Button x:Name="ExpandComposerButton" DockPanel.Dock="Right" Click="ExpandComposerClick" Style="{StaticResource RailButton}" IsEnabled="{Binding IsEnabled, ElementName=Composer}" ToolTip="Mở rộng vùng soạn thảo" AutomationProperties.Name="Mở rộng vùng soạn thảo"><TextBlock x:Name="ExpandComposerIcon" Text="&#xE740;" Style="{StaticResource Icon}"/></Button>
      </DockPanel>
      <local:RichComposer x:Name="Composer" MinHeight="56" MaxHeight="130" Padding="8" BorderThickness="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AcceptsReturn="True" PreviewKeyDown="ComposerKeyDown" TextChanged="ComposerTextChanged" SelectionChanged="ComposerSelectionChanged" AutomationProperties.Name="Soạn tin nhắn" ToolTip="Enter để gửi, Shift+Enter xuống dòng"/>
      <WrapPanel x:Name="FormattingToolbar" Visibility="Collapsed" Margin="0,5,0,0" IsEnabled="{Binding IsEnabled, ElementName=Composer}"/>
      <DockPanel Margin="0,6,0,0">
       <Button DockPanel.Dock="Right" x:Name="SendButton" Click="SendClick" Style="{StaticResource AccentButton}" Width="44" Height="38" Padding="0" ToolTip="Gửi tin nhắn" AutomationProperties.Name="Gửi tin nhắn"><TextBlock Text="&#xE724;" Style="{StaticResource Icon}" Foreground="White" HorizontalAlignment="Center"/></Button>
       <TextBlock x:Name="ComposerHint" Text="Enter để gửi · Shift+Enter xuống dòng" Style="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </DockPanel>
     </StackPanel>
    </Border>
   </Grid>
   <Border x:Name="DetailsPanel" Grid.Column="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
    <Grid>
    <DockPanel x:Name="DetailsContent" Margin="16,22">
     <StackPanel DockPanel.Dock="Top" Margin="6,0,6,16">
      <Border Width="52" Height="52" CornerRadius="16" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left"><Grid><TextBlock x:Name="DetailInitials" Text="L" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/><Image x:Name="DetailAvatar" Width="52" Height="52" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,52,52" RadiusX="16" RadiusY="16"/></Image.Clip></Image></Grid></Border>
      <TextBlock x:Name="DetailName" Text="Thông tin hội thoại" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,6"/>
      <TextBlock x:Name="DetailStatus" Style="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="18" FontSize="11"/>
     </StackPanel>
     <TabControl x:Name="InfoTabs" Background="Transparent" BorderThickness="0" FontSize="11">
      <TabItem Header="Chia sẻ"><DockPanel><Button x:Name="RefreshSharedButton" DockPanel.Dock="Top" Click="RefreshSharedClick" HorizontalAlignment="Right" Margin="0,8,0,0" Padding="9,5" ToolTip="Làm mới nội dung chia sẻ" AutomationProperties.Name="Làm mới nội dung chia sẻ"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13"/><TextBlock Text="Làm mới" Margin="6,0,0,0"/></StackPanel></Button><TabControl Background="Transparent" BorderThickness="0" Margin="0,8,0,0" FontSize="11">
       <TabItem Header="Media"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="4,14"><TextBlock x:Name="NoMedia" Text="Ảnh và video được chia sẻ xuất hiện ở đây." Style="{StaticResource Muted}" TextWrapping="Wrap"/><WrapPanel x:Name="SharedMedia"/></StackPanel></ScrollViewer></TabItem>
       <TabItem Header="Tệp"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4,14"><TextBlock x:Name="NoFiles" Text="Chưa có tệp được chia sẻ." Style="{StaticResource Muted}" TextWrapping="Wrap"/><StackPanel x:Name="SharedFiles"/></StackPanel></ScrollViewer></TabItem>
       <TabItem Header="Link"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4,14"><TextBlock x:Name="NoLinks" Text="Link trong tin nhắn xuất hiện ở đây." Style="{StaticResource Muted}" TextWrapping="Wrap"/><StackPanel x:Name="SharedLinks"/></StackPanel></ScrollViewer></TabItem>
      </TabControl></DockPanel></TabItem>
      <TabItem Header="Tìm kiếm"><StackPanel Margin="6,18"><TextBlock Text="Tìm trong hội thoại" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBox x:Name="MessageSearch" TextChanged="MessageSearchChanged" AutomationProperties.Name="Tìm trong trò chuyện"/><TextBlock Text="Kết quả xuất hiện trong log chat. Xóa từ khóa để xem lại hội thoại." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></TabItem>
      <TabItem Header="Cài đặt"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="6,16">
       <Button x:Name="RenamePeerButton" Content="Đặt tên riêng" Click="RenamePeerClick" Margin="0,0,0,10" Visibility="Collapsed"/>
       <Button x:Name="ShareContactButton" Content="Chia sẻ liên hệ" Click="ShareContactClick" Margin="0,0,0,10" Visibility="Collapsed"/>
       <Button x:Name="AddGroupMembersButton" Content="Thêm thành viên" Click="AddGroupMembersClick" Margin="0,0,0,10" Visibility="Collapsed"/>
       <Button x:Name="PinnedMessagesButton" Content="Tin nhắn đã ghim" Click="ShowPinnedMessagesClick" Margin="0,0,0,10"/>
       <Button x:Name="ConversationRulesButton" Content="Quyền hội thoại" Click="ConversationRulesClick" Margin="0,0,0,10"/>
       <Button x:Name="LeaveGroupButton" Content="Rời nhóm" Click="LeaveGroupClick" Margin="0,0,0,10" Visibility="Collapsed"/>
       <Button x:Name="DeleteGroupButton" Content="Xóa nhóm trên mọi máy" Click="DeleteGroupClick" Margin="0,0,0,10" Visibility="Collapsed"/>
       <Button x:Name="ExpirySettingsButton" Content="Tin nhắn tự hủy · Tắt" Click="ExpirySettingsClick" Margin="0,0,0,10"/>
       <Button x:Name="ConversationPasswordButton" Content="Mật khẩu hội thoại" Click="ConversationPasswordClick" Margin="0,0,0,10"/>
       <Button x:Name="LockConversationButton" Content="Khóa hội thoại ngay" Click="LockConversationClick" Margin="0,0,0,10" Visibility="Collapsed"/>
       <Button x:Name="SelectMessagesButton" Content="Chọn nhiều tin nhắn" Click="SelectMessagesClick" Margin="0,0,0,10"/>
       <Button x:Name="ClearHistoryButton" Content="Dọn lịch sử hội thoại" Click="ClearHistoryClick" Margin="0,0,0,10"/>
       <Separator Margin="0,14"/>
       <TextBlock Text="Mã hóa khi truyền" FontSize="12" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Danh tính giữ nguyên khi IP thay đổi." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
       <Button x:Name="BlockButton" Content="Chặn máy này" Click="BlockClick" Margin="0,20,0,0" Visibility="Collapsed"/>
      </StackPanel></ScrollViewer></TabItem>
     </TabControl>
    </DockPanel>
    <Border x:Name="DetailsLocked" Visibility="Collapsed" Padding="24" VerticalAlignment="Top">
     <StackPanel><TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" Foreground="{DynamicResource MutedBrush}" FontSize="28" Margin="0,8,0,16"/><TextBlock Text="Thông tin đang khóa" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/><TextBlock Text="Mở khóa hội thoại để xem nội dung chia sẻ, tìm kiếm và cài đặt." Style="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel>
    </Border>
    </Grid>
   </Border>
  </Grid>
  <Border x:Name="StatusBar" Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"><Grid Margin="16,0"><TextBlock x:Name="NetworkStatus" Text="Đang khởi động…" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/><TextBlock x:Name="ToastText" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="520" TextTrimming="CharacterEllipsis"/></Grid></Border>
  <Border x:Name="LoginHost" Grid.RowSpan="2" Visibility="Collapsed" Background="{DynamicResource CanvasBrush}"/>
 </Grid>
</Window>
